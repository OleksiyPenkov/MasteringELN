---
export type CalloutKind = 'tip' | 'remember' | 'warning' | 'deeper' | 'eln' | 'team';

interface Props { kind: CalloutKind; title?: string; }
const { kind, title } = Astro.props;

const LABEL: Record<CalloutKind, string> = {
  tip: 'Tip',
  remember: 'Remember',
  warning: 'Warning',
  deeper: 'Going Deeper',
  eln: 'In ELN',
  team: 'In a Team Lab',
};
const heading = title ? `${LABEL[kind]}: ${title}` : LABEL[kind];
const collapsible = kind === 'deeper';
---
{collapsible ? (
  <details class={`box box-${kind} box-collapsible`}>
    <summary class="box-title">
      <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="3" rx="1" /><rect x="3" y="10.5" width="18" height="3" rx="1" /><rect x="3" y="17" width="18" height="3" rx="1" />
      </svg>
      <span>{heading}</span>
    </summary>
    <div class="box-body"><slot /></div>
  </details>
) : (
  <aside class={`box box-${kind}`} aria-label={LABEL[kind]}>
    <p class="box-title">
      {kind === 'tip' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke-width="2" /><path d="M8 12h7M12 8.5l3.5 3.5L12 15.5" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      )}
      {kind === 'remember' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 3h10v18l-5-4-5 4z" />
        </svg>
      )}
      {kind === 'warning' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3 22 20H2z" /><path d="M12 9v5M12 16.5v.5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" />
        </svg>
      )}
      {kind === 'eln' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke-width="2" /><path d="M8 3v18M12 8h6M12 12h6M12 16h4" fill="none" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      )}
      {kind === 'team' && (
        <svg class="box-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="9" cy="8" r="3" fill="none" stroke-width="2" /><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" fill="none" stroke-width="2" stroke-linecap="round" /><circle cx="16.5" cy="9.5" r="2.3" fill="none" stroke-width="1.8" /><path d="M15 19c.3-2.2 1.8-3.8 4-3.8 1.2 0 2 .5 2.5 1.3" fill="none" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      )}
      <span>{heading}</span>
    </p>
    <div class="box-body"><slot /></div>
  </aside>
)}
